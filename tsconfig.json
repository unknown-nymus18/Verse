{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app/index.jsx",
    "app/(details)/index.jsx",
    "app/details.jsx",
    "app/(home)/index.tsx",
    "app/(home)/search.jsx",
    "app/(home)/_layout.jsx"
  ]
}
